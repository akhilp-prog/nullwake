# Credentials the worker uses to reach warehouses and alert channels. Only the worker container receives this
# file. Copy to worker.env (keep it even if empty) and reference these names from your YAML (dsnEnv, urlEnv, ...).

# Postgres: use sslmode=verify-full with the server's CA for anything reached over a network
# WAREHOUSE_DSN=host=warehouse.internal dbname=analytics user=nullwake_reader password=... sslmode=verify-full sslrootcert=/run/secrets/warehouse-ca.pem
# SNOWFLAKE_PRIVATE_KEY_FILE=/run/secrets/snowflake_key.p8
# BIGQUERY_CREDENTIALS_FILE=/run/secrets/bigquery.json

# Alert channels referenced by AlertChannel YAML
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# ONCALL_WEBHOOK_URL=https://events.example.com/nullwake
# ONCALL_WEBHOOK_SECRET=  # openssl rand -hex 32
