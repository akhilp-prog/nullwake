# Public hostname served by Caddy (automatic HTTPS via Let's Encrypt).
NULLWAKE_DOMAIN=app.nullwake.si

# Metadata database password (Compose Postgres). Generate: openssl rand -base64 32
POSTGRES_PASSWORD=change-me

# Warehouse connections are referenced by env-var name from your Connection YAML, e.g.:
# WAREHOUSE_DSN=host=warehouse.internal dbname=analytics user=nullwake_reader password=... sslmode=require
# SNOWFLAKE_PRIVATE_KEY_FILE=/run/secrets/snowflake_key.p8

# Alert channels referenced by AlertChannel YAML, e.g.:
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# ONCALL_WEBHOOK_URL=https://events.example.com/nullwake
# ONCALL_WEBHOOK_SECRET=  # openssl rand -hex 32

# --- Public demo only (docker compose --profile demo up) ---
NULLWAKE_DEMO_MODE=false
NULLWAKE_DEMO_USER=demo@nullwake.si
NULLWAKE_DEMO_PASSWORD=see-it-break-live
DEMO_READER_PASSWORD=change-me-too
